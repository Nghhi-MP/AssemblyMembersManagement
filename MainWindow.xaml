<Window x:Name="MainWindow1" x:Class="WarningManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarningManager"
        mc:Ignorable="d"
        FocusManager.FocusedElement="{Binding ElementName=studentNameField}"
        Closed="MainWindow1_Closed"
        Title="אסיפה - ישיבה" Height="515" Width="800">
    <Grid>
        <Rectangle Height="217" VerticalAlignment="Top" Fill="#FF009DFF"/>
        <ComboBox x:Name="studentNameField" Height="29" Margin="96,94,96,0" VerticalAlignment="Top" IsEditable="True" ItemsSource="{Binding AssemblyMembers}" DisplayMemberPath="Name" FontSize="16" KeyDown="ComboBox_KeyDown" Loaded="ComboBox_Loaded" FlowDirection="RightToLeft"/>
        <TextBlock Margin="224,62,224,0" TextWrapping="Wrap" Text="הקלד שם חבר" TextAlignment="Center" FontSize="18" Height="28" VerticalAlignment="Top" Foreground="White"/>
        <ListView x:Name="warningInformationBox" d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding AssemblyMembers}" Margin="0,169,0,0" FontSize="14" FlowDirection="RightToLeft">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="שם חבר" Width="170" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="אזהרה (מספר)" Width="150" DisplayMemberBinding="{Binding WarningLevel}"/>
                    <GridViewColumn Header="מצב" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="5,2" CornerRadius="3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Normal">
                                                    <Setter Property="Background" Value="Gray"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Raising">
                                                    <Setter Property="Background" Value="#FF009DFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="HasSpeakingAuthority">
                                                    <Setter Property="Background" Value="#FF0082D2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Warned">
                                                    <Setter Property="Background" Value="#FFCCCC00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="InLastWarning">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Ejected">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateTitle}" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="SubjectTimerBtn" Content="התחל נושא" Margin="638,12,10,0" Click="SubjectTimerBtn_Click" Height="32" VerticalAlignment="Top" FontSize="16"/>
        <Button x:Name="ConcludeSubjectBtn" Content="סיכום" Margin="481,12,167,0" Click="ConcludeSubjectBtn_Click"  Height="32" VerticalAlignment="Top" FontSize="16" Visibility="Visible"/>
        <TextBlock x:Name="TimerLbl" Margin="24,10,666,0" TextWrapping="Wrap" Text="0 : 0" FontSize="22" FontWeight="Bold" Foreground="#FF009DFF" Height="36" VerticalAlignment="Top" Background="White" TextAlignment="Center"/>
        <TextBlock x:Name="SubjectNameLbl" FlowDirection="RightToLeft" Margin="194,10,372,0" TextWrapping="Wrap" Text="" TextAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Height="36" VerticalAlignment="Top"/>
        <Button Content="הגדרות" Visibility="Hidden" Height="27" Margin="682,49,10,0" VerticalAlignment="Top" Click="Button_Click"/>

    </Grid>
</Window>

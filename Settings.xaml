<Window x:Class="SessionMembersOrder.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SessionMembersOrder"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="Settings" Height="254" Width="342">
    <Grid Background="#FF009DFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="461*"/>
            <ColumnDefinition Width="242*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Fill="#FF6AA9FF" Margin="1,0,0,0" Height="212" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <Label Content="שעת סיכום ישיבות" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" Width="180" Foreground="White" FontFamily="Segoe UI Variable Display"/>
        <TextBox x:Name="MinutesBox" HorizontalAlignment="Left" Height="20" Margin="10,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="24"/>
        <TextBox x:Name="HoursBox" HorizontalAlignment="Left" Height="20" Margin="39,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="24"/>
        <Label Content=":" HorizontalAlignment="Left" Margin="30,42,0,0" VerticalAlignment="Top" Width="18" Foreground="Black" FontFamily="Segoe UI Variable Display"/>
        <Button Content="[Enter]" IsDefault="True" HorizontalAlignment="Left" Height="22" Margin="126,198,0,0" VerticalAlignment="Top" Width="92" Click="Button_Click"/>

    </Grid>
</Window>
